{
  "name": "@ewe/browser",
  "version": "0.5.0-beta",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "ewe browser — Chromium engine, Electron runtime, minimal shell",
  "main": "./out/main/index.js",
  "author": "Giorgi Macharashvili",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "electron-builder --linux",
    "screenshots": "node scripts/visual.mjs docs/screenshots"
  },
  "dependencies": {
    "@ewe/shared": "workspace:*",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "music-metadata": "^12.1.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.64.0",
    "dompurify": "^3.4.16",
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "solid-js": "^1.9.17",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  }
}
