    "@playwright/test": "^1.64.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "solid-js": "^1.9.17",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.4"
  }
