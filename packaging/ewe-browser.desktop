[Desktop Entry]
Type=Application
Name=ewe Browser
GenericName=Web Browser
Comment=Browse the web, your files and your music
Exec=ewe-browser %U
Icon=ewe-browser
Terminal=false
Categories=Network;WebBrowser;
Keywords=web;browser;internet;files;music;pdf;
# Folders stay with the file manager the desktop seeds (Nemo); Settings → Files
# in the app hands inode/directory over through its own ewe-browser-folders.desktop.
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/pdf;
StartupNotify=true
StartupWMClass=ewe-browser
Actions=new-window;

[Desktop Action new-window]
Name=New window
Exec=ewe-browser --new-window
